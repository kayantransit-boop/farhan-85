# Copier ce fichier en .env et remplir les valeurs

# MongoDB Atlas connection string (obtenu sur mongodb.com)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/djibouti-rencontre

# Clé secrète JWT - générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_UNE_LONGUE_CLE_ALEATOIRE

# URL du frontend en production (ex: https://djibouti-rencontre.vercel.app)
FRONTEND_URL=http://localhost:5173

# Port (Render le définit automatiquement)
PORT=3001
